{
  "description": "A cross-field arithmetic check catches an internally-inconsistent misread that every per-field check passes. quantity, unit_price and total_usd are each individually plausible and in range; only their relation is wrong.",
  "instruction": "The source document is one invoice line.\n\nRead:\n\nquantity: the number of units.\n\nunit_price: the price per unit in USD, as a number.\n\ntotal_usd: the line total in USD, as a number.\n\nCite the verbatim span you read each value from.",
  "target_fields": [
    {
      "name": "quantity",
      "value_type": "float",
      "minimum": 0.0,
      "maximum": 10000.0,
      "required": true,
      "min_evidence": 1
    },
    {
      "name": "unit_price",
      "value_type": "float",
      "minimum": 0.0,
      "maximum": 100000.0,
      "required": true,
      "min_evidence": 1
    },
    {
      "name": "total_usd",
      "value_type": "float",
      "minimum": 0.0,
      "maximum": 1000000.0,
      "required": true,
      "min_evidence": 1
    }
  ],
  "grain": {
    "identity_fields": [
      "line_id"
    ],
    "canonical_sort": [
      "line_id"
    ],
    "duplicate_policy": "reject",
    "source_locators": [],
    "identity_bearing_inputs": [
      "line_id"
    ]
  },
  "cardinality": {
    "min_rows": 1,
    "max_rows": 1,
    "expected_per_input": 1
  },
  "thresholds": {
    "max_degrade_share": 1.0,
    "max_error_rate": 0.0,
    "max_unverified_share": 0.0,
    "max_absent_share": 0.0,
    "max_validation_retries": 1
  },
  "input_adapter": "landed_text",
  "model": "claude-opus-5",
  "effort": "medium",
  "accepts_media": [],
  "cross_field_checks": [
    {
      "kind": "product_equals",
      "target": "total_usd",
      "operands": [
        "quantity",
        "unit_price"
      ],
      "tolerance": 0.005
    }
  ],
  "spec_version": "1"
